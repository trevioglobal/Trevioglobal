# Local: http://localhost:4000
# Vercel: set ONLY the value (no "NEXT_PUBLIC_API_URL=" prefix, no leading "="):
# https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# demo | live — controls login helpers and default mock inventory
NEXT_PUBLIC_APP_MODE=demo

# Mock flights/hotels search (sample data only). Force off for live:
# NEXT_PUBLIC_ENABLE_MOCK_INVENTORY=false

# Seed role chips + demo password on login screen:
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# Platform shells (Monitoring, Marketing/coupons, CMS, API Marketplace). On by default in demo:
# NEXT_PUBLIC_ENABLE_STUB_MODULES=true
