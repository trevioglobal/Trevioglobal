# Local: http://localhost:4000
# Vercel: set ONLY the value (no "NEXT_PUBLIC_API_URL=" prefix, no leading "="):
# https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# demo | live — controls login helpers and default mock inventory
NEXT_PUBLIC_APP_MODE=demo

# Production (Vercel) uses live + all of these false.
# NEXT_PUBLIC_ENABLE_MOCK_INVENTORY=false
# NEXT_PUBLIC_ENABLE_STUB_MODULES=false
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# NEXT_PUBLIC_ALLOW_PUBLIC_REGISTER=false
