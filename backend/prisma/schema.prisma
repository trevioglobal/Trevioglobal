// Travel Partner Pro — Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  password     String?
  role         String   @default("employee") // super_admin|agency_admin|branch_manager|employee|accountant|customer
  designation  String?
  agencyId     String?
  branchId     String?
  avatar       String?
  status       String   @default("Active")
  permissions  Json?    // null = use role default; array of module keys = explicit override
  lastLogin    DateTime?
  resetToken       String?
  resetTokenExpires DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency       Agency?  @relation(fields: [agencyId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
  bookings     Booking[] @relation("BookingAgent")
  salesBookings Booking[] @relation("BookingSales")
  opsBookings  Booking[] @relation("BookingOps")
  leads        Lead[]
  tasks        Task[]   @relation("TaskAssignee")
  quotations   Quotation[]
  auditLogs    AuditLog[]
  paymentsCollected Payment[]
  attendance   Attendance[]
  leaves       Leave[]  @relation("LeaveOwner")
  approvedLeaves Leave[] @relation("LeaveApprover")
  assignedChangeRequests ChangeRequest[] @relation("ChangeRequestAssignee")

  @@index([agencyId])
  @@index([branchId])
}

model Agency {
  id              String   @id @default(cuid())
  name            String
  owner           String
  email           String
  phone           String
  plan            String   @default("Starter") // Starter|Growth|Enterprise
  status          String   @default("Active")  // Active|Suspended|Trial
  walletBalance   Int      @default(0)
  commissionEarned Int     @default(0)
  totalBookings   Int      @default(0)
  monthlyRevenue  Int      @default(0)
  apiAllocation   Json     @default("{}") // {flights,hotels}
  gstNumber       String?
  panNumber       String?
  vatNumber       String?
  address         String?
  country         String?
  state           String?
  city            String?
  gstProofUrl     String?
  termsAcceptedAt DateTime?
  logo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  branches        Branch[]
  bookings        Booking[]
}

model Branch {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  manager   String
  city      String
  revenue   Int      @default(0)
  createdAt DateTime @default(now())

  agency    Agency   @relation(fields: [agencyId], references: [id])
  users     User[]

  @@index([agencyId])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  type          String   @default("Individual") // Individual|Corporate
  tier          String   @default("Silver") // Silver|Gold|Platinum
  totalBookings Int      @default(0)
  totalSpent    Int      @default(0)
  loyaltyPoints Int      @default(0)
  passportNo    String?
  visaStatus    String?  // Valid|Expired|None
  city          String?
  agencyId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  leads         Lead[]
  travelRequirements TravelRequirement[]
  travelProposals    TravelProposal[]
}

model Booking {
  id            String   @id @default(cuid())
  bookingRef    String   @unique
  customerName  String
  customerId    String?
  service       String   // Flight|Hotel|Holiday
  route         String
  travelDate    String
  amount        Int
  commission    Int      @default(0)
  // FRD: Draft|Awaiting Passenger Details|Pending Initial Payment|Partially Paid|Payment Received|In Progress|Partially Confirmed|Confirmed|Travel Documents Ready|Completed|Cancelled (+ legacy Pending|Ticketed|Refunded|Failed)
  status        String   @default("Draft")
  paymentStatus String   @default("Pending") // Paid|Pending|Partial|Refunded
  paymentMethod String?
  agentId       String?
  agentName     String
  agencyId      String?
  agencyName    String
  branchId      String?
  // BMS fields
  quotationId   String?
  quoteNo       String?
  destination   String?
  nights        Int?
  totalRooms    Int?
  adults        Int?
  children      Int?
  infants       Int?
  packageValue  Int?
  amountPaid    Int      @default(0)
  balanceAmount Int      @default(0)
  costPrice     Int      @default(0)
  grossProfit   Int      @default(0)
  netProfit     Int      @default(0)
  salesExecutiveId       String?
  salesExecutiveName     String?
  operationsExecutiveId  String?
  operationsExecutiveName String?
  isInternational Boolean @default(false)
  policiesAcceptedAt DateTime?
  pricingLocked   Boolean  @default(true)
  pricingSnapshot Json?
  termsAndConditions String? @db.Text
  paymentTerms       String? @db.Text
  cancellationPolicy String? @db.Text
  packageIncludes    Json    @default("[]")
  packageExcludes    Json    @default("[]")
  currency           String  @default("INR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer? @relation(fields: [customerId], references: [id])
  agency        Agency?   @relation(fields: [agencyId], references: [id])
  agent         User?     @relation("BookingAgent", fields: [agentId], references: [id])
  salesExecutive User?    @relation("BookingSales", fields: [salesExecutiveId], references: [id])
  operationsExecutive User? @relation("BookingOps", fields: [operationsExecutiveId], references: [id])
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  payments      Payment[]
  passengers    BookingPassenger[]
  paymentRequests PaymentRequest[]
  services      BookingService[]
  supplierLines BookingSupplierLine[]
  documents     BookingDocument[]
  invoices      BookingInvoice[]
  changeRequests ChangeRequest[]
  addOns        BookingAddOn[]
  supplierPayouts SupplierPayout[]
  modifications BookingModification[]

  @@index([agencyId])
  @@index([customerId])
  @@index([agentId])
  @@index([branchId])
  @@index([quotationId])
  @@index([status])
}

model Payment {
  id          String   @id @default(cuid())
  txnId       String   @unique
  customerName String
  bookingRef  String
  bookingId   String?
  agencyId    String?
  branchId    String?
  collectedById String?
  amount      Int
  method      String   // Razorpay|UPI|Card|Net Banking|Cash|Bank Transfer|Wallet
  status      String   @default("Success") // Success|Pending|Failed|Refunded
  type        String   @default("Payment") // Payment|Refund|Wallet Credit|Commission
  gateway     String?
  date        DateTime @default(now())

  booking     Booking? @relation(fields: [bookingId], references: [id])
  collectedBy User?    @relation(fields: [collectedById], references: [id])

  @@index([agencyId])
  @@index([branchId])
  @@index([collectedById])
}

model Lead {
  id           String   @id @default(cuid())
  agencyId     String?
  branchId     String?
  customerName String
  email        String
  phone        String
  source       String   // Website|WhatsApp|Phone|Walk-in|Facebook|Instagram|Google Ads|Referral
  service      String   // Flight|Hotel|Holiday
  value        Int
  stage        String   @default("New") // New|Qualified|Follow-up|Quotation Sent|Negotiation|Won|Lost
  assignedToId String?
  assignedTo   String
  expectedClose String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedToUser User?  @relation(fields: [assignedToId], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerId     String?
  travelRequirements TravelRequirement[]
  travelProposals    TravelProposal[]

  @@index([agencyId])
  @@index([branchId])
}

model Quotation {
  id         String   @id @default(cuid())
  agencyId   String?
  branchId   String?
  quoteNo    String   @unique
  customerName String
  service    String   // Flight|Hotel|Holiday|International|Activity|Transfer
  items      Int
  amount     Int
  gst        Int
  total      Int
  // FRD: Draft|In Progress|Pending Approval|Sent to Agent|Customer Reviewing|Revision Requested|Accepted|Rejected|Expired|Converted to Booking|Archived (+ legacy Sent)
  status     String   @default("Draft")
  validTill  String
  createdById String?
  createdBy  String
  isInternational Boolean @default(false)
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  destination   String?
  country       String?
  coverImage    String?
  departureCity String?
  travelDates   String?
  returnDate    String?
  nights        Int?
  days          Int?
  adults        Int?
  children      Int?
  infants       Int?
  hotelStarPreference String?
  roomTypePreference  String?
  mealPlanPreference  String?
  location      String?
  budget        Int?
  currency      String   @default("INR")
  packageIncludes Json   @default("[]")
  packageExcludes Json   @default("[]")
  termsAndConditions String?
  paymentTerms    String?
  cancellationPolicy String?
  salesExecutiveName  String?
  salesExecutivePhone String?
  salesExecutiveEmail String?
  approvalStatus  String  @default("Draft") // Draft|Pending|Approved|Rejected
  lineItems       Json    @default("[]")
  couponCode      String?
  couponDiscount  Int     @default(0)
  // Quotation Management Module (FRD)
  quoteDate       String?
  travelStartDate String?
  travelEndDate   String?
  agentName       String?
  agentId         String?
  specialRequests String?  @db.Text
  internalNotes   String?  @db.Text
  refundPolicy    String?  @db.Text
  hotelTerms      String?  @db.Text
  flightTerms     String?  @db.Text
  visaTerms       String?  @db.Text
  insuranceTerms  String?  @db.Text
  forceMajeure    String?  @db.Text
  travelDisclaimer String? @db.Text
  termsSnapshot   Json?
  baseCurrency    String   @default("INR")
  exchangeRate    Float    @default(1)
  totalNetCost    Int      @default(0)
  totalSelling    Int      @default(0)
  grossProfit     Int      @default(0)
  profitMargin    Float    @default(0)
  discountType    String?  // Fixed|Percentage
  discountValue   Float    @default(0)
  discountAmount  Int      @default(0)
  taxRate         Float    @default(18)
  taxableAmount   Int      @default(0)
  perPersonCost   Int      @default(0)
  currentVersion  Int      @default(1)
  wizardStep      Int      @default(1)
  enquiryRef      String?
  selectedPackageId String?
  acceptedByName  String?
  acceptedByEmail String?
  acceptedAt      DateTime?
  rejectedReason  String?
  convertedBookingId String?
  convertedAt     DateTime?
  convertedBy     String?
  archivedAt      DateTime?
  deletedAt       DateTime?
  travelProposalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  createdByUser User? @relation(fields: [createdById], references: [id])
  bookings      Booking[]
  packages      QuotationPackage[]
  versions      QuotationVersion[]
  approvals     QuotationApproval[]
  revisions     QuotationRevision[]
  shares        QuotationShare[]
  documents     QuotationDocument[]

  @@index([agencyId])
  @@index([couponCode])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
  @@index([destination])
}

model QuotationPackage {
  id              String   @id @default(cuid())
  quotationId     String
  name            String   // Economy|Deluxe|Premium|Luxury|Custom
  sortOrder       Int      @default(0)
  isSelected      Boolean  @default(false)
  description     String?
  hotels          Json     @default("[]")
  flights         Json     @default("[]")
  transfers       Json     @default("[]")
  activities      Json     @default("[]")
  meals           Json     @default("[]")
  itinerary       Json     @default("[]")
  visa            Json?
  insurance       Json?
  addOns          Json     @default("[]")
  inclusions      Json     @default("[]")
  exclusions      Json     @default("[]")
  totalNetCost    Int      @default(0)
  totalSelling    Int      @default(0)
  grossProfit     Int      @default(0)
  gst             Int      @default(0)
  total           Int      @default(0)
  perPersonCost   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model QuotationVersion {
  id            String   @id @default(cuid())
  quotationId   String
  versionNumber Int
  snapshot      Json
  changeSummary String?
  reason        String?
  createdByName String?
  createdById   String?
  createdAt     DateTime @default(now())

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, versionNumber])
  @@index([quotationId])
}

model QuotationApproval {
  id            String   @id @default(cuid())
  quotationId   String
  stage         String   // Team Lead|Finance|Ready to Send
  status        String   @default("Pending") // Pending|Approved|Rejected
  approverName  String?
  approverRole  String?
  comments      String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model QuotationRevision {
  id            String   @id @default(cuid())
  quotationId   String
  requestedBy   String
  requestedByRole String?
  comments      String?  @db.Text
  requestedChanges String? @db.Text
  status        String   @default("Open") // Open|Addressed|Closed
  createdAt     DateTime @default(now())

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model QuotationShare {
  id            String   @id @default(cuid())
  quotationId   String
  channel       String   // Email|WhatsApp|Link
  recipient     String?
  senderName    String?
  message       String?
  status        String   @default("Attempted") // Attempted|Sent|Failed
  createdAt     DateTime @default(now())

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model QuotationDocument {
  id            String   @id @default(cuid())
  quotationId   String
  docType       String
  fileName      String
  fileUrl       String
  mimeType      String?
  sizeBytes     Int      @default(0)
  visibility    String   @default("Internal") // Internal|Agent|Customer
  relatedEntity String?
  uploadedBy    String?
  createdAt     DateTime @default(now())

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Task {
  id          String   @id @default(cuid())
  agencyId    String?
  branchId    String?
  bookingId   String?
  title       String
  description String?
  assignedToId String?
  assignedTo  String
  assignedBy  String
  department  String?  // Sales|Operations|Finance|Management
  priority    String   @default("Medium") // Low|Medium|High|Urgent|Critical
  status      String   @default("To Do") // To Do|Pending|In Progress|On Hold|Review|Completed|Cancelled
  dueDate     String
  dueTime     String?
  relatedTo   String?
  remarks     String?
  createdAt   DateTime @default(now())

  assignee    User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([agencyId])
  @@index([branchId])
  @@index([bookingId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  agencyId    String?
  type        String   // Credit|Debit
  source      String   // Commission|Payment|Refund|Top-up|Transfer|Booking
  amount      Int
  balance     Int
  description String
  paymentRef  String?  @unique // Razorpay payment id — prevents replay credits
  date        DateTime @default(now())

  @@index([agencyId])
}

model Employee {
  id           String   @id @default(cuid())
  agencyId     String?
  branchId     String?
  name         String
  email        String   @unique
  phone        String
  designation  String
  department   String
  branch       String
  role         String
  status       String   @default("Active")
  salary       Int      @default(0)
  incentives   Int      @default(0)
  target       Int      @default(0)
  achieved     Int      @default(0)
  attendance   Int      @default(95)
  permissions  Json?    // null = use role default; array of module keys = explicit override (mirrors User.permissions)
  joinDate     String
  createdAt    DateTime @default(now())

  @@index([agencyId])
  @@index([branchId])
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  agencyId  String?
  branchId  String?
  date      String    // "YYYY-MM-DD"
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("Present") // Present|Absent|Half Day|On Leave
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([agencyId])
  @@index([branchId])
}

model Leave {
  id             String   @id @default(cuid())
  userId         String
  userName       String
  agencyId       String?
  branchId       String?
  type           String   // Casual|Sick|Earned|Unpaid
  fromDate       String
  toDate         String
  reason         String
  status         String   @default("Pending") // Pending|Approved|Rejected
  approvedById   String?
  approvedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation("LeaveOwner", fields: [userId], references: [id])
  approvedBy     User?    @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([agencyId])
  @@index([branchId])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  agencyId      String?
  bookingId     String?
  userName      String
  userRole      String?
  action        String
  module        String
  ip            String?
  details       String?
  previousValue Json?
  updatedValue  Json?
  comments      String?
  createdAt     DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([agencyId])
  @@index([bookingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // booking|payment|api|customer|internal|task
  title     String
  message   String
  priority  String   @default("low") // low|medium|high
  read      Boolean  @default(false)
  userId    String?
  agencyId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([agencyId])
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  agencyId    String?
  name        String
  type        String   // Email|SMS|Push
  status      String   @default("Draft") // Draft|Active|Completed|Paused
  audience    String
  sentCount   Int      @default(0)
  openRate    Float    @default(0)
  clickRate   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId])
}

/// Agency-scoped discount codes — create in Marketing, apply on quotations (and future checkout).
model Coupon {
  id             String   @id @default(cuid())
  agencyId       String
  code           String
  type           String   // Flat|Percent
  value          Int
  minOrderAmount Int      @default(0)
  usageLimit     Int      @default(0) // 0 = unlimited
  usedCount      Int      @default(0)
  maxDiscount    Int?     // optional cap for Percent coupons (INR)
  validFrom      DateTime @default(now())
  validTill      DateTime
  status         String   @default("Active") // Active|Paused|Expired
  description    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions    CouponRedemption[]

  @@unique([agencyId, code])
  @@index([agencyId])
  @@index([status])
  @@index([validTill])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  agencyId       String
  userId         String?
  quotationId    String?
  orderAmount    Int
  discountAmount Int
  code           String
  createdAt      DateTime @default(now())

  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([agencyId])
  @@index([quotationId])
  @@index([code])
}

model ContentPage {
  id          String   @id @default(cuid())
  agencyId    String?
  title       String
  slug        String
  content     String
  status      String   @default("Draft") // Published|Draft|Archived
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencyId, slug])
  @@index([agencyId])
}

model ContentPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  status      String   @default("Draft") // Published|Draft|Archived
  author      String
  category    String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id          String   @id @default(cuid())
  agencyId    String?
  name        String
  key         String   @unique
  environment String   @default("Test") // Test|Production
  status      String   @default("Active") // Active|Revoked
  calls       Int      @default(0)
  limit       Int      @default(1000)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  @@index([agencyId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  agencyId    String?
  ticketId    String   @unique
  subject     String
  description String
  status      String   @default("Open") // Open|In Progress|Resolved|Closed
  priority    String   @default("Medium") // Low|Medium|High|Critical|Urgent
  operationsType String @default("general_inquiry") // routes to department
  deliveryType   String @default("remote") // how request will be fulfilled
  department     String @default("General Support")
  scheduledAt    DateTime? // when deliveryType = scheduled
  customerName String
  customerId  String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    TicketMessage[]

  @@index([agencyId])
  @@index([operationsType])
  @@index([deliveryType])
  @@index([department])
  @@index([status])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  sender      String
  message     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
}

model Settings {
  id          String   @id @default(cuid())
  agencyId    String   @unique
  theme       String   @default("system")
  currency    String   @default("INR")
  timezone    String   @default("Asia/Kolkata")
  notifications Boolean @default(true)
  rolePermissions Json?
  apiKeys     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Product Catalog ──────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  agencyId    String?
  name        String
  contactPerson String?
  email       String?
  phone       String?
  type        String   // Hotel|Activity|Transfer|General
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotels      HotelProduct[]
  activities  ActivityProduct[]
  transfers   TransferProduct[]

  @@index([agencyId])
}

model HotelProduct {
  id              String   @id @default(cuid())
  agencyId        String?
  supplierId      String?
  destinationId   String?
  name            String
  description     String?
  starCategory    Int      @default(3)
  address         String?
  city            String
  country         String   @default("India")
  mapsUrl         String?
  amenities       Json     @default("[]")
  policies        Json     @default("{}")
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("11:00")
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  website         String?
  images          Json     @default("[]")
  roomCategories  Json     @default("[]") // [{ name, description, images, maxOccupancy, maxAdults, maxChildren, extraBedAllowed, roomSize, bedType, mealPlan, smoking, pricing:{single,double,triple,quad,extraAdult,extraChild}, weekdayPricing, weekendPricing }]
  contractStart   String?
  contractEnd     String?
  childPolicy     Json     @default("{}") // { withBed, withoutBed }
  currency        String   @default("INR")
  cancellationPolicy String?
  blackoutDates   Json     @default("[]") // [{ label, dateFrom, dateTo }]
