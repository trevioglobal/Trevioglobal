model ApiMetric {
  id            String   @id @default(cuid())
  endpoint      String   // /api/products, /api/auth/login, etc
  method        String   // GET, POST, PUT, DELETE, PATCH
  statusCode    Int
  responseTime  Int      // milliseconds
